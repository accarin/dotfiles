{{- /*
  Shared fastfetch layout. Called with a dict: .mode = "nerd" | "emoji".
  Rendered into ~/.config/fastfetch/config.jsonc (nerd) and
  config-emoji.jsonc (emoji); fish_greeting picks one at runtime.
*/ -}}
{{- $icons := dict
      "nerd" (dict
        "os" "\\uf17c " "kernel" "\\uf085 " "uptime" "\\uf017 " "shell" "\\uf120 "
        "term" "\\uf489 " "pkgs" "\\uf487 " "cpu" "\\uf2db " "gpu" "\\uf26c "
        "mem" "\\uefc5 " "disk" "\\uf0a0 ")
      "emoji" (dict
        "os" "🐧 " "kernel" "🔧 " "uptime" "⏳ " "shell" "🐚 "
        "term" "📺 " "pkgs" "📦 " "cpu" "🧠 " "gpu" "🎮 "
        "mem" "🐏 " "disk" "💾 ") -}}
{{- $i := index $icons .mode -}}
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "{{ .chezmoi.homeDir }}/.config/fastfetch/logo.txt",
        "color": { "1": "cyan" },
        "padding": { "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 12 },
        "color": { "keys": "cyan", "title": "cyan" }
    },
    "modules": [
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "separator", "string": "─" },
        { "type": "os",       "key": "{{ $i.os }}distro",   "format": "{pretty-name}" },
        { "type": "kernel",   "key": "{{ $i.kernel }}kernel",   "format": "{release}" },
        { "type": "uptime",   "key": "{{ $i.uptime }}uptime",   "format": "{?days}{days}d {?}{hours}h {minutes}m" },
        { "type": "shell",    "key": "{{ $i.shell }}shell",    "format": "{pretty-name}" },
        { "type": "terminal", "key": "{{ $i.term }}term",   "format": "{pretty-name}" },
        { "type": "packages", "key": "{{ $i.pkgs }}pkgs",   "format": "{all}" },
        { "type": "cpu",      "key": "{{ $i.cpu }}cpu",     "format": "{name}" },
        { "type": "gpu",      "key": "{{ $i.gpu }}gpu",     "format": "{name}" },
        { "type": "memory",   "key": "{{ $i.mem }}memory",  "format": "{used} / {total} ({percentage})" },
        { "type": "disk",     "key": "{{ $i.disk }}disk",    "format": "{size-used} / {size-total} ({size-percentage})", "folders": "/" }
    ]
}
