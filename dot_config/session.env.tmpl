# =============================================================================
# ~/.config/session.env — session environment, single source of truth.
# Managed by chezmoi — machine type: {{ .machine_type }}
#
# Read by fish (config.fish) and by ~/.profile, which greetd sources (sh)
# before starting Hyprland/niri. SDDM used to start the session through
# `fish --login`; greetd doesn't, so GUI apps get these only via ~/.profile.
#
# Format: KEY=value, one per line, literal values only (no quotes, no $VAR,
# no ~); blank lines and # comments are ignored. PATH is handled separately
# (fish_add_path / ~/.profile).
# =============================================================================

EDITOR=nvim
VISUAL=nvim
PAGER=less

# --- XDG Base Dirs ---
XDG_CONFIG_HOME={{ .chezmoi.homeDir }}/.config
XDG_DATA_HOME={{ .chezmoi.homeDir }}/.local/share
XDG_CACHE_HOME={{ .chezmoi.homeDir }}/.cache

# --- Wayland / Desktop ---
XDG_CURRENT_DESKTOP=niri
XDG_SESSION_TYPE=wayland
MOZ_ENABLE_WAYLAND=1
QT_QPA_PLATFORM=wayland
{{- if eq .machine_type "notebook" }}

# --- Notebook: HiDPI / compact display tweaks ---
GDK_SCALE=1
GDK_DPI_SCALE=1.25
QT_SCALE_FACTOR=1.25
{{- end }}
{{- if eq .machine_type "gaming" }}

# --- Gaming PC additions ---
# MangoHud for all Vulkan games
MANGOHUD=1
# GameMode
SDL_AUDIODRIVER=pipewire
{{- end }}
