# =============================================================================
# ~/.config/fish/config.fish
# Managed by chezmoi — machine type: {{ .machine_type }}
# =============================================================================

# --- PATH ---
fish_add_path ~/.local/bin

# --- Environment ---
set -gx EDITOR nvim
set -gx VISUAL nvim
set -gx PAGER  less

# --- XDG Base Dirs ---
set -gx XDG_CONFIG_HOME ~/.config
set -gx XDG_DATA_HOME   ~/.local/share
set -gx XDG_CACHE_HOME  ~/.cache

# --- Wayland / Desktop (all non-server/wsl types) ---
{{- if and (ne .machine_type "server") (ne .machine_type "wsl") }}
set -gx XDG_CURRENT_DESKTOP niri
set -gx XDG_SESSION_TYPE    wayland
set -gx MOZ_ENABLE_WAYLAND  1
set -gx QT_QPA_PLATFORM     wayland
{{- end }}

# --- Notebook: HiDPI / compact display tweaks ---
{{- if eq .machine_type "notebook" }}
set -gx GDK_SCALE 1
set -gx GDK_DPI_SCALE 1.25
set -gx QT_SCALE_FACTOR 1.25
{{- end }}

# --- Gaming PC additions ---
{{- if eq .machine_type "gaming" }}
# MangoHud for all Vulkan games
set -gx MANGOHUD 1
# GameMode
set -gx SDL_AUDIODRIVER pipewire
{{- end }}

# --- Aliases ---
alias v    nvim
alias vi   nvim
alias vim  nvim
alias ..   'cd ..'
alias ...  'cd ../..'

# --- Modern tool replacements (personal desktop shell — fine to override
#     core tools here, unlike the shared-friendly bash setup on servers) ---
alias ls   'eza --icons --group-directories-first -1'
alias ll   'eza -lah --icons --group-directories-first'
alias la   'eza -A --icons --group-directories-first'
alias cat  bat
alias grep rg
alias find fd

# --- Git abbreviations (replicates caelestia's fish component, which we
#     disable via `caelestia install --disable-components fish,starship,...` to
#     avoid it clobbering this file — see caelestia-implementation-plan.md.
#     github.com/caelestia-dots/caelestia/blob/main/fish/config.fish)
#     NOTE: changes `gl` from this file's previous meaning (git pull) to
#     git log, matching caelestia; use `gpl` for pull now. ---
abbr lg  'lazygit'
abbr gd  'git diff'
abbr ga  'git add .'
abbr gc  'git commit -am'
abbr gl  'git log'
abbr gs  'git status'
abbr gst 'git stash'
abbr gsp 'git stash pop'
abbr gp  'git push'
abbr gpl 'git pull'
abbr gsw 'git switch'
abbr gsm 'git switch main'
abbr gb  'git branch'
abbr gbd 'git branch -d'
abbr gco 'git checkout'
abbr gsh 'git show'

# --- chezmoi shortcut ---
alias cm   'chezmoi --no-pager'
alias cmu  'chezmoi --no-pager update -v'
alias cmt  'chezmoi --no-pager apply --dry-run --verbose'
alias cma  'chezmoi --no-pager apply -v'
alias cmd  'chezmoi --no-pager diff'

# --- Greeting ---
function fish_greeting
    # fetch-banner handles icon detection, tmux/vscode skipping and narrow terminals.
    # `set -g banner_icons nerd|emoji` forces an icon set.
    set -l env COLUMNS=$COLUMNS
    set -q banner_icons; and set -a env BANNER_ICONS=$banner_icons
    command -q fetch-banner; and env $env fetch-banner
end

# --- Starship prompt ---
starship init fish | source

# --- zoxide (smart cd) ---
zoxide init fish --cmd cd | source
alias z cd

# --- direnv (auto-load per-directory .envrc) ---
command -v direnv &>/dev/null && direnv hook fish | source

# --- Terminal prompt marking (OSC 133 — lets kitty/foot jump between
#     prompts); same mechanism caelestia's fish config uses. ---
function mark_prompt_start --on-event fish_prompt
    echo -en "\e]133;A\e\\"
end