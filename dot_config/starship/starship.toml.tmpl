# ~/.config/starship/starship.toml
# Managed by chezmoi
# Symbols/styling loosely inspired by caelestia's starship.toml
# (github.com/caelestia-dots/caelestia/blob/main/starship.toml) — a curated
# subset, not a 1:1 port (upstream also configures ~50 per-language version
# modules we have no use for). See caelestia-implementation-plan.md.

"$schema" = "https://starship.rs/config-schema.json"

add_newline = false

{{ if eq .machine_type "notebook" -}}
# Compact format for notebook — save horizontal space
format = """
$directory$git_branch$git_status$character"""

[directory]
truncation_length = 2
home_symbol       = "⌂"

{{ else -}}
# Full format for wide screens
format = """
$username$hostname$directory$git_branch$git_status$cmd_duration
$character"""

[directory]
truncation_length = 3
truncation_symbol = "…/"
home_symbol       = "⌂"

{{ end -}}

[character]
success_symbol = "[◎](bold green)"
error_symbol   = "[○](bold red)"

[git_branch]
symbol = "▲ "
style  = "italic bright-blue"

[git_status]
ahead      = "⇡${count}"
behind     = "⇣${count}"
diverged   = "⇕⇡${ahead_count}⇣${behind_count}"
conflicted = "◪"
stashed    = "◃◈"

[cmd_duration]
min_time = 0
format   = "[◄ $duration]($style) "
style    = "italic white"

[username]
style_user  = "bright-yellow bold"
style_root  = "purple bold"
format      = "[⭘ $user]($style) "
show_always = false

[sudo]
format   = "[⋈┈]($style) "
style    = "bold bright-purple"
disabled = false

{{ if eq .machine_type "notebook" -}}
[battery]
full_symbol         = "█"
charging_symbol     = "[↑](bold green)"
discharging_symbol  = "↓"
format              = "[$percentage$symbol]($style) "

[[battery.display]]
threshold = 20
style     = "bold red"

[[battery.display]]
threshold = 50
style     = "bold yellow"
{{ end -}}