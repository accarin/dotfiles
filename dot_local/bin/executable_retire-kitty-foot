#!/usr/bin/env bash
# retire-kitty-foot — one-shot migration of a desktop from kitty/foot to
# ghostty (main) + alacritty (alternative). Managed by chezmoi.
#
# Run it AFTER `chezmoi update` has brought this machine to the new repo
# state (ghostty/alacritty installed, keybinds pointing at ghostty, kitty
# config removed via .chezmoiremove). It does what chezmoi can't:
#   1. caelestia: drop the "foot" component. `caelestia update` can't remove
#      components, so this re-runs `caelestia install` with the machine's own
#      current component choices minus foot. NOTE: install also pulls the
#      newest caelestia dots (same as `caelestia update` would).
#   2. Remove the kitty and foot packages (pacman asks for confirmation).
#   3. Remove leftover ~/.config/foot and ~/.config/kitty.
# Idempotent: re-running only does what is still left. --dry-run shows the plan.

set -Eeuo pipefail
shopt -s inherit_errexit

PROG=${0##*/}
DRY_RUN=false
VERBOSE=false
CHANGES=0
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}
DOTS_STATE=$STATE_DIR/caelestia/dots-state.json
MANIFEST=$STATE_DIR/caelestia/dots/manifest.toml
LOG_FILE=$STATE_DIR/$PROG.log
PACKAGES=(kitty kitty-terminfo kitty-shell-integration foot foot-terminfo)
LEFTOVER_DIRS=("$CONFIG_DIR/foot" "$CONFIG_DIR/kitty")

# ---------- logging ----------
if [[ -t 2 ]]; then
    C_RST=$'\e[0m' C_STEP=$'\e[1;34m' C_OK=$'\e[32m' C_PLAN=$'\e[36m'
    C_CHG=$'\e[1;33m' C_WARN=$'\e[33m' C_ERR=$'\e[1;31m' C_DBG=$'\e[2m'
else
    C_RST='' C_STEP='' C_OK='' C_PLAN='' C_CHG='' C_WARN='' C_ERR='' C_DBG=''
fi
_log() {
    local color=$1 level=$2; shift 2
    printf '%s%-6s%s %s\n' "$color" "$level" "$C_RST" "$*" >&2
    if ! $DRY_RUN && [[ -n ${LOG_READY:-} ]]; then
        printf '%s %-6s %s\n' "$(date '+%F %T')" "$level" "$*" >>"$LOG_FILE"
    fi
}
log_step()  { _log "$C_STEP" STEP "$@"; }
log_ok()    { _log "$C_OK" OK "$@"; }
log_plan()  { _log "$C_PLAN" PLAN "$@"; }
log_chg()   { _log "$C_CHG" CHANGE "$@"; }
log_warn()  { _log "$C_WARN" WARN "$@"; }
log_err()   { _log "$C_ERR" ERROR "$@"; }
log_debug() { if $VERBOSE; then _log "$C_DBG" DEBUG "$@"; fi; }
die()       { log_err "$@"; exit 1; }

# plan <description>: count a change; announce it as planned or applied.
plan() {
    CHANGES=$((CHANGES + 1))
    if $DRY_RUN; then log_plan "would: $*"; else log_chg "$*"; fi
}

on_err() {
    local rc=$? line=$1 cmd=$2
    [[ $BASHPID != "$$" ]] && exit "$rc"
    log_err "line $line: '$cmd' failed (exit $rc). Fix the cause and re-run; the script is idempotent."
    exit "$rc"
}
trap 'on_err "$LINENO" "$BASH_COMMAND"' ERR
trap 'log_warn "interrupted"; exit 130' INT TERM

usage() {
    cat <<EOF
Usage: $PROG [--dry-run] [-v|--verbose] [-h|--help]

Retire kitty and foot on this desktop (ghostty = main, alacritty = alternative):
drop caelestia's foot component, remove the kitty/foot packages and leftover
config dirs. Run after 'chezmoi update'. Run as your normal user (not root);
sudo is used for pacman only.

  --dry-run      show what would change, change nothing
  -v, --verbose  show debug output
  -h, --help     this help
EOF
}

while (($#)); do
    case $1 in
        --dry-run) DRY_RUN=true ;;
        -v|--verbose) VERBOSE=true ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

# ---------- preflight ----------
[[ $EUID -ne 0 ]] || die "run as your normal user, not root (caelestia state is per user; sudo is used for pacman)"
for cmd in pacman python3; do
    command -v "$cmd" >/dev/null 2>&1 || die "required command not found: $cmd (this script is for CachyOS/Arch desktops)"
done
if ! $DRY_RUN; then
    mkdir -p "$STATE_DIR"
    : >>"$LOG_FILE"; chmod 600 "$LOG_FILE"
    LOG_READY=1
fi
$DRY_RUN && log_step "dry run: nothing will be changed"

# Lock-out guard: never remove kitty/foot unless the replacement terminal is there.
replacement_ok=true
if ! command -v ghostty >/dev/null 2>&1; then
    replacement_ok=false
    msg="ghostty is not installed: run 'chezmoi update' first (its package script installs ghostty + alacritty)"
    if $DRY_RUN; then log_warn "$msg; a real run would stop here"; else die "$msg"; fi
fi
case "${TERM:-}:${KITTY_WINDOW_ID:-}" in
    xterm-kitty:*|foot*:*|*:?*)
        log_warn "you are running this inside kitty/foot: the window keeps working, but open ghostty for future sessions" ;;
esac

# ---------- 1. caelestia foot component ----------
log_step "caelestia: foot component"
if [[ ! -f $DOTS_STATE ]]; then
    log_ok "caelestia dots not installed on this machine; nothing to do"
elif ! command -v caelestia >/dev/null 2>&1; then
    log_warn "$DOTS_STATE exists but the caelestia command is missing; skipping"
else
    # Prints: <aur_helper> TAB <foot enabled: yes|no> TAB <enable csv> TAB <disable csv>
    if ! info=$(python3 - "$DOTS_STATE" "$MANIFEST" <<'PY'
import json, sys, tomllib
state = json.load(open(sys.argv[1]))
enabled = state.get("enabled_components", [])
names = [c["name"] for c in tomllib.load(open(sys.argv[2], "rb")).get("components", [])]
keep = [n for n in names if n in enabled and n != "foot"]
drop = [n for n in names if n not in keep]
print(state.get("aur_helper") or "paru", "yes" if "foot" in enabled else "no",
      ",".join(keep), ",".join(drop), sep="\t")
PY
    ); then
        die "could not read $DOTS_STATE / $MANIFEST"
    fi
    IFS=$'\t' read -r aur_helper foot_enabled enable_csv disable_csv <<<"$info"
    log_debug "aur_helper=$aur_helper enable=$enable_csv disable=$disable_csv"
    if [[ $foot_enabled == "no" ]]; then
        log_ok "foot component already disabled"
    else
        cmd=(caelestia install --aur-helper "$aur_helper"
             --enable-components "$enable_csv" --disable-components "$disable_csv" --noconfirm)
        plan "re-run caelestia install without foot (keeps: $enable_csv)"
        log_debug "command: ${cmd[*]}"
        if ! $DRY_RUN; then
            # An existing ~/.config.bak makes caelestia skip its ~/.config
            # backup, which crashes on special files (IPC sockets).
            mkdir -p "$HOME/.config.bak"
            "${cmd[@]}"
            if python3 -c 'import json,sys; sys.exit("foot" in json.load(open(sys.argv[1])).get("enabled_components", []))' "$DOTS_STATE"; then
                log_ok "foot component disabled"
            else
                die "caelestia install finished but foot is still enabled in $DOTS_STATE"
            fi
        fi
    fi
fi

# ---------- 2. packages ----------
log_step "packages: ${PACKAGES[*]}"
installed=()
for p in "${PACKAGES[@]}"; do
    if pacman -Q "$p" >/dev/null 2>&1; then installed+=("$p"); fi
done
if ((${#installed[@]} == 0)); then
    log_ok "none of them installed"
elif ! $replacement_ok; then
    log_plan "would: remove ${installed[*]} (only once ghostty is installed)"
    CHANGES=$((CHANGES + 1))
else
    plan "sudo pacman -Rns ${installed[*]}"
    if ! $DRY_RUN; then
        sudo pacman -Rns "${installed[@]}"
        log_ok "packages removed"
    fi
fi

# ---------- 3. leftover config dirs ----------
log_step "leftover config dirs"
for d in "${LEFTOVER_DIRS[@]}"; do
    if [[ -e $d ]]; then
        plan "rm -r $d"
        if ! $DRY_RUN; then rm -r -- "$d"; fi
    else
        log_ok "$d already gone"
    fi
done

# ---------- summary ----------
if ((CHANGES == 0)); then
    log_ok "already in desired state: kitty and foot are retired"
elif $DRY_RUN; then
    log_step "$CHANGES change(s) would be made; run '$PROG' without --dry-run to apply"
else
    log_ok "$CHANGES change(s) applied (log: $LOG_FILE)"
    log_step "next: open a new ghostty window (Super+Return) and check the sysmon workspace still opens btop"
fi
