#!/usr/bin/env bash
# fetch-banner — logo + system specs via fastfetch (used by fish and bash startup)
# Managed by chezmoi
#
# Icon set: BANNER_ICONS=nerd|emoji overrides auto-detection. Fonts can't be
# detected from a shell, so guess from the terminal; unknown terminals get emoji.

command -v fastfetch >/dev/null 2>&1 || exit 0

# Nested/embedded terminals: stay quiet
[ -n "${TMUX:-}" ] && exit 0
[ "${TERM_PROGRAM:-}" = vscode ] && exit 0

mode=${BANNER_ICONS:-}
if [ -z "$mode" ]; then
    mode=emoji
    case "${TERM:-}" in
        linux) ;;
        xterm-ghostty|alacritty|wezterm) mode=nerd ;;
        # TERM overridden (e.g. xterm-256color): recognise ghostty/alacritty
        # by the env vars they set in their child shells
        *) [ -n "${GHOSTTY_RESOURCES_DIR:-}${ALACRITTY_WINDOW_ID:-}" ] && mode=nerd ;;
    esac
fi

cfg=$HOME/.config/fastfetch/config.jsonc
[ "$mode" = emoji ] && cfg=$HOME/.config/fastfetch/config-emoji.jsonc
[ -r "$cfg" ] || exit 0

args=(-c "$cfg")

# Drop the logo on narrow terminals so lines don't wrap
cols=${COLUMNS:-$(tput cols 2>/dev/null)}
[ "${cols:-80}" -lt 70 ] 2>/dev/null && args+=(--logo none)

exec fastfetch "${args[@]}"
