# .chezmoiignore — interpreted as a template
# Logic is INVERTED: list what to IGNORE (not what to include)

# Never deploy the README to the home dir
README.md

# --- Wayland / window manager configs ---
# Only deploy on non-server machines (workstation, gaming, notebook)
{{- if eq .machine_type "server" }}
.config/niri
.config/waybar
.config/wofi
.config/mako
.config/hypr
.vscode/argv.json
{{- end }}
# Session logout helper (logout alias) — desktops only
{{- if or (eq .machine_type "server") (eq .machine_type "wsl") }}
.local/bin/wm-logout
{{- end }}

# --- Caelestia (Hyprland shell/rice) configs ---
# Only deploy the chezmoi-managed caelestia override files (shell.json,
# cli.json, hypr-vars.lua, hypr-user.lua) on machines where caelestia is
# actually enabled; see .chezmoidata.toml's [caelestia] table.
{{- $caelestiaEnabled := .caelestia.enabled }}
{{- $hostname := .chezmoi.hostname }}
{{- if hasKey .machines $hostname }}
{{-   $machine := index .machines $hostname }}
{{-   if hasKey $machine "caelestia" }}
{{-     $machineCaelestia := index $machine "caelestia" }}
{{-     if hasKey $machineCaelestia "enabled" }}
{{-       $caelestiaEnabled = index $machineCaelestia "enabled" }}
{{-     end }}
{{-   end }}
{{- end }}
{{- if or (eq .machine_type "server") (not $caelestiaEnabled) }}
.config/caelestia
{{- end }}

# --- Gaming-only configs ---
# Ignore on everything except gaming
{{- if ne .machine_type "gaming" }}
.config/gamemode
.config/mangohud
.config/environment.d/10-gamescope-session.conf
.local/share/lutris
{{- end }}

# --- Server-only configs ---
# Ignore on everything except server
{{- if ne .machine_type "server" }}
.config/server-motd
{{- end }}

# --- Shell: deploy the right shell config ---
# Server + wsl use bash, desktops (workstation/gaming/notebook) use fish
{{- if not (or (eq .machine_type "server") (eq .machine_type "wsl")) }}
dot_bashrc
{{- end }}
{{- if or (eq .machine_type "server") (eq .machine_type "wsl") }}
.config/fish
{{- end }}
# Ignore Starship on server + wsl
{{- if or (eq .machine_type "server") (eq .machine_type "wsl") }}
.config/starship
{{- end }}
# VS Code automation-shell override only matters where fish is the
# interactive default (desktop/gaming); server + wsl already default to
# bash interactively, so skip it there.
{{- if or (eq .machine_type "server") (eq .machine_type "wsl") }}
.config/Code/User/settings.json
{{- end }}

