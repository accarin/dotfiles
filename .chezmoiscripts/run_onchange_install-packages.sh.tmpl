#!/bin/bash
# run_onchange_install-packages.sh.tmpl
# Re-runs only when this file's content changes (i.e., when you edit the package list)
# Managed by chezmoi

set -euo pipefail

{{- if or (eq .machine_type "server") (eq .machine_type "wsl") }}

# ============================================================
# SERVER / WSL — Debian packages
# ============================================================
DEBIAN_PKGS=(
    bash-completion
    git
    gh
    curl
    wget
    htop
    btop
    tmux
    micro
    nano
    ripgrep
    fd-find
    fzf
    zoxide
    bat
    eza
    unzip
    tree
    jq
)

echo "==> Installing Debian packages..."
sudo apt-get update -qq
# fastfetch is only packaged in Debian 13+ / Ubuntu 25.04+; skip it elsewhere
# (the startup banner then stays silent)
if apt-cache show fastfetch >/dev/null 2>&1; then
    DEBIAN_PKGS+=(fastfetch)
else
    echo "==> fastfetch not available in this release's apt repos; skipping"
fi
sudo apt-get install -y "${DEBIAN_PKGS[@]}"

# Set bash as the default login shell (servers/wsl only — coadmins have
# their own accounts, this only ever touches the user chezmoi runs as)
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$(command -v bash)" ]; then
    chsh -s "$(command -v bash)"
fi

{{- else }}

# ============================================================
# DESKTOP — CachyOS / Arch packages (pacman + paru for AUR)
# ============================================================

PACMAN_PKGS=(
    # Shell & terminal
    kitty
    fish
    starship
    foot
    tmux

    # Editors & tools
    neovim
    git
    github-cli
    curl
    wget
    btop
    ripgrep
    fd
    fzf
    bat
    eza
    zoxide
    direnv
    jq
    unzip
    tree
    seahorse

    # Wayland / desktop
    # niri
    # waybar
    # wofi
    # mako
    # wl-clipboard
    # xdg-utils
    # pipewire
    # wireplumber
    hyprland
    # Graceful logout (closes apps first); caelestia's logout command in
    # shell.json.tmpl uses it when present and falls back to a hard exit.
    hyprshutdown
    noctalia

    # Utilties
    bolt

    # Fonts
    ttf-jetbrains-mono-nerd
)

AUR_PKGS=(
    # AUR packages common to all desktops
    caelestia-cli
    hyprmod
    # Mainline Quickshell, needed by caelestia-shell -- replaces the archived
    # noctalia-qs fork's package slot (Conflicts: quickshell, quickshell-git)
    # now that niri runs the native v5 noctalia (no Quickshell dependency).
    # MUST use the aur/ prefix: noctalia-qs's Provides=quickshell-git makes
    # plain `quickshell-git` silently resolve to reinstalling noctalia-qs
    # instead of building the real AUR package (confirmed via `paru -Sp
    # quickshell-git` pointing at noctalia-qs's cached .pkg.tar.zst even
    # after noctalia-qs was removed). See caelestia-implementation-plan.md.
    aur/quickshell-git
)

{{-   $netbird_enabled := .netbird.enabled }}
{{-   $hostname := .chezmoi.hostname }}
{{-   if hasKey .machines $hostname }}
{{-     $machine := index .machines $hostname }}
{{-     if hasKey $machine "netbird" }}
{{-       $machineNetbird := index $machine "netbird" }}
{{-       if hasKey $machineNetbird "enabled" }}
{{-         $netbird_enabled = index $machineNetbird "enabled" }}
{{-       end }}
{{-     end }}
{{-   end }}
{{-   if $netbird_enabled }}
AUR_PKGS+=(
    # Not in the official repos; setup is done by run_onchange_after_setup-netbird.sh.tmpl
    aur/netbird
)
{{-   end }}

{{-   if eq .machine_type "gaming" }}
PACMAN_PKGS+=(
    steam
    gamemode
    gamescope
    gamescope-session-cachyos
    mangohud
    lib32-mangohud
    wine
    winetricks
    lutris
    vulkan-tools
)

AUR_PKGS+=(
    # Explicit -bin: proton-ge-custom is only a virtual Provides of both
    # proton-ge-custom-bin and proton-ge-bin (which conflict), so paru prompts.
    aur/proton-ge-custom-bin
)
{{-   end }}

{{-   if eq .machine_type "notebook" }}
PACMAN_PKGS+=(
    brightnessctl
    tlp
    powertop
    acpi
)
{{-   end }}

echo "==> Installing pacman packages..."
sudo pacman -S --needed --noconfirm "${PACMAN_PKGS[@]}"

if command -v paru &>/dev/null && [ ${#AUR_PKGS[@]} -gt 0 ]; then
    echo "==> Installing AUR packages via paru..."
    paru -S --needed --noconfirm "${AUR_PKGS[@]}"
fi

# Set fish as default shell (desktops only)
if ! grep -q "$(which fish)" /etc/shells; then
    echo "$(which fish)" | sudo tee -a /etc/shells
fi
if [ "$SHELL" != "$(which fish)" ]; then
    chsh -s "$(which fish)"
fi

{{- end }}

echo "==> Package installation complete."